      "id": "agent4-conversation-handler",
      "name": "AGENTE 4 - Conversation Handler",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 700],
      "credentials": {},
      "notes": "Claude API - Gerencia conversa bidirecional"
    },
    {
      "parameters": {
        "jsCode": "// Constrói histórico da conversa para o Claude\nconst survey = $node['Supabase - Get Survey'].json[0];\nconst newMessage = $node['Parse Webhook'].json.customer_message;\n\n// Recupera histórico anterior ou inicia novo\nconst conversationHistory = survey.conversation_transcript || [];\n\n// Adiciona nova mensagem do cliente\nconversationHistory.push({\n  role: 'user',\n  content: newMessage\n});\n\nreturn {\n  json: {\n    messages: conversationHistory,\n    survey_id: survey.id,\n    turn_count: Math.floor(conversationHistory.length / 2) + 1\n  }\n};"
      },
      "id": "build-conversation-history",
      "name": "Build Conversation History",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 700],
      "notes": "Monta histórico completo da conversa"
    },
    {
      "parameters": {
        "jsCode": "// Parse resposta do Claude (JSON com response, status, extracted_data)\nconst claudeResponse = $input.first().json.content[0].text;\n\ntry {\n  const response = JSON.parse(claudeResponse);\n  \n  const surveyData = $node['Supabase - Get Survey'].json[0];\n  const turnCount = $node['Build Conversation History'].json.turn_count;\n  const maxTurns = 5;\n  \n  // Decide se deve continuar ou finalizar\n  if (response.status === 'completed' || response.status === 'escalate') {\n    return {\n      json: {\n        ...response,\n        should_continue: false,\n        final_status: response.status,\n        survey_id: surveyData.id\n      }\n    };\n  }\n  \n  if (turnCount >= maxTurns) {\n    return {\n      json: {\n        response: \"Obrigada pelo seu tempo! Qualquer coisa, estamos à disposição.\",\n        status: 'completed',\n        extracted_data: response.extracted_data,\n        should_continue: false,\n        final_status: 'timeout',\n        survey_id: surveyData.id\n      }\n    };\n  }\n  \n  // Continuar conversa\n  return {\n    json: {\n      ...response,\n      should_continue: true,\n      turn_count: turnCount,\n      survey_id: surveyData.id\n    }\n  };\n  \n} catch (error) {\n  // Fallback: escalar para humano em caso de erro\n  console.error('Erro ao processar resposta:', error);\n  return {\n    json: {\n      response: \"Vou transferir você para nossa equipe. Aguarde um momento!\",\n      status: 'escalate',\n      extracted_data: { satisfaction_score: null, feedback: 'Erro no processamento' },\n      should_continue: false,\n      final_status: 'error',\n      survey_id: $node['Supabase - Get Survey'].json[0].id\n    }\n  };\n}"
      },
      "id": "process-conversation-response",
      "name": "Process Conversation Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 700],
      "notes": "Processa resposta e decide próximo passo"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.should_continue}}",
              "value2": true
            }
          ]
        }
      },
