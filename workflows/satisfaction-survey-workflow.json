    {
      "parameters": {
        "jsCode": "// Extrai mensagem do Claude\nconst claudeResponse = $input.first().json.content[0].text;\nconst message = claudeResponse.trim();\n\n// Validações\nif (message.length > 400) {\n  console.warn('Mensagem muito longa:', message.length);\n}\n\nif (!message.includes('1 a 5') && !message.includes('1-5')) {\n  console.warn('Mensagem não solicita nota explicitamente');\n}\n\nreturn { \n  json: { \n    message: message,\n    contact_name: $node['AGENTE 1 - Data Fetcher'].json.contact.name,\n    contact_phone: $node['AGENTE 1 - Data Fetcher'].json.contact.phone,\n    analysis: $node['Validate Analysis'].json\n  } \n};"
      },
