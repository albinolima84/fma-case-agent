    {
      "parameters": {
        "jsCode": "// Extrai dados da mensagem recebida\nconst webhookData = $input.first().json;\n\nconst customerPhone = webhookData.data.key.remoteJid.replace('@s.whatsapp.net', '');\nconst customerMessage = webhookData.data.message.conversation || webhookData.data.message.extendedTextMessage?.text || '';\n\nreturn {\n  json: {\n    customer_phone: customerPhone,\n    customer_message: customerMessage,\n    timestamp: webhookData.data.messageTimestamp\n  }\n};"
      },
      "id": "parse-webhook",
      "name": "Parse Webhook",
      "type": "n8n-nodes-base.code",
