      "id": "webhook-whatsapp",
      "name": "Webhook - WhatsApp Response",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 700],
      "webhookId": "whatsapp-response-webhook",
      "notes": "Recebe respostas do cliente via Evolution API"
